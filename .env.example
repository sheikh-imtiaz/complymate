# ---- Shared ----
ENVIRONMENT=local
CLOUD_PROVIDER=local            # local | aws | azure
LOG_LEVEL=INFO
DEFAULT_JURISDICTION=AU

# ---- Database (owner runs migrations, app is RLS-restricted) ----
DATABASE_URL=postgresql+asyncpg://complymate_app:app_password@localhost:5432/complymate
DATABASE_ADMIN_URL=postgresql+asyncpg://complymate_owner:owner_password@localhost:5432/complymate
APP_DB_PASSWORD=app_password

# ---- Auth ----
DEV_JWT_SECRET=change-me-dev-only
OIDC_ISSUER=
OIDC_AUDIENCE=
STEP_UP_MFA_SECONDS=600

# ---- Storage / queue / email (local stack) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
DOCUMENTS_BUCKET=complymate-documents
EXPORTS_BUCKET=complymate-exports
AUDIT_ARCHIVE_BUCKET=complymate-audit
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@complymate.test

# ---- AI ----
LLM_MODEL_ID=anthropic.claude-sonnet-4-5
LLM_FAST_MODEL_ID=anthropic.claude-haiku-4-5
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRACTICE=
STRIPE_PRICE_ONBOARDING=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
NEXT_PUBLIC_AUTH_MODE=dev
