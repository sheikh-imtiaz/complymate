NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
NEXT_PUBLIC_WS_MODE=native          # native (local/Azure) | apigw (AWS API Gateway WebSocket)
NEXT_PUBLIC_AUTH_MODE=dev           # dev | oidc
NEXT_PUBLIC_OIDC_ISSUER=            # https://cognito-idp.ap-southeast-2.amazonaws.com/<pool-id>
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_DOMAIN=            # https://<prefix>.auth.ap-southeast-2.amazoncognito.com
NEXT_PUBLIC_ENVIRONMENT=local
