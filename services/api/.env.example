ENVIRONMENT=local
CLOUD_PROVIDER=local
DATABASE_URL=postgresql+asyncpg://complymate_app:app_password@localhost:5432/complymate
DATABASE_ADMIN_URL=postgresql+asyncpg://complymate_owner:owner_password@localhost:5432/complymate
APP_DB_PASSWORD=app_password
DEV_JWT_SECRET=change-me-dev-only
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SMTP_HOST=localhost
SMTP_PORT=1025
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# AWS (set by Terraform on Lambda)
# AWS_REGION=ap-southeast-2
# DB_SECRET_ARN=arn:aws:secretsmanager:...:secret:complymate/dev/db-app
# DB_ADMIN_SECRET_ARN=arn:aws:secretsmanager:...:secret:rds!cluster-...
# COGNITO_USER_POOL_ID=ap-southeast-2_xxx
# OIDC_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_xxx
# OIDC_AUDIENCE=<app client id>
# QUEUE_URL_PREFIX=https://sqs.ap-southeast-2.amazonaws.com/123456789012/complymate-dev-
# STRIPE_SECRET_ARN=arn:aws:secretsmanager:...:secret:complymate/dev/stripe
